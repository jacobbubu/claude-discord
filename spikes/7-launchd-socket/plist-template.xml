<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jacobbubu.claude-discord-spike-7</string>

    <key>ProgramArguments</key>
    <array>
        <string>{BUN_PATH}</string>
        <string>run</string>
        <string>{INSTALL_DIR}/daemon-stub.ts</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{HOME}</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>SPIKE7_SOCKET</key>
        <string>{HOME}/.claude/channels/discord/spike-7.sock</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>{HOME}/.claude/channels/discord/spike-7.err.log</string>
    <key>StandardOutPath</key>
    <string>{HOME}/.claude/channels/discord/spike-7.out.log</string>

    <key>WorkingDirectory</key>
    <string>{INSTALL_DIR}</string>
</dict>
</plist>
