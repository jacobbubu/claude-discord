{
  "name": "claude-discord-bot",
  "version": "0.1.0",
  "description": "Drive Claude Code from Discord — machine-level agent gateway daemon. One bot routes to N CC workspaces via channel binding (`/use <workspace>`).",
  "type": "module",
  "license": "MIT",
  "author": "jacobbubu",
  "homepage": "https://github.com/jacobbubu/claude-discord#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacobbubu/claude-discord.git"
  },
  "bugs": {
    "url": "https://github.com/jacobbubu/claude-discord/issues"
  },
  "keywords": [
    "claude-code",
    "discord",
    "mcp",
    "bot",
    "agent",
    "gateway",
    "daemon"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    ".claude-plugin",
    "CONTRIBUTING.md"
  ],
  "bin": {
    "claude-discord-bot": "./src/cli/index.ts"
  },
  "scripts": {
    "start": "bun run src/cli/index.ts start",
    "dev": "bun --watch src/cli/index.ts start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli/index.ts --target=bun --outdir=dist",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "discord.js": "^14.26.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/bun": "latest",
    "@vitest/coverage-v8": "^4.1.5",
    "semantic-release": "^24.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
