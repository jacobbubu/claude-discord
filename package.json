{
  "name": "claude-discord-bot",
  "version": "0.0.43",
  "description": "A Claude Code Discord plugin \u2014 machine-level agent gateway daemon for Discord \u00d7 Claude Code",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "claude-discord-bot": "./src/cli/index.ts"
  },
  "scripts": {
    "start": "bun run src/cli/index.ts start",
    "dev": "bun --watch src/cli/index.ts start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli/index.ts --target=bun --outdir=dist",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "discord.js": "^14.26.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@vitest/coverage-v8": "^4.1.5",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
